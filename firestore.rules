rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Dados Pessoais do Usuário (Fichas salvas, preferências)
    // Apenas o próprio usuário autenticado pode ler e escrever seus documentos
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Campanhas na Nuvem
    // - Leitura: Permitida para qualquer usuário autenticado (para entrar via código)
    // - Criação: Apenas se o usuário for o Mestre (dmId == request.auth.uid)
    // - Edição: Mestre tem controle total; Jogadores podem atualizar sua presença em 'members'
    // - Exclusão: Apenas o Mestre criador da campanha
    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.dmId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.dmId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
      );
      allow delete: if request.auth != null && resource.data.dmId == request.auth.uid;

      // Pistas e Handouts da Campanha (gerenciados pelo Mestre da campanha)
      match /handouts/{handoutId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmId == request.auth.uid
        );
      }
    }

    // 3. Usuários Online (Presença em Tempo Real)
    // - Leitura: Permitida para usuários autenticados para ver quem está online no site
    // - Escrita: O usuário só pode registrar ou remover a SUA PRÓPRIA presença
    match /online_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. Lista de Amigos
    // - Totalmente Privada: Apenas o dono da lista de amigos pode ler e editar
    match /user_friends/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. Convites para Jogar (Game Invites)
    // Usuários autenticados podem criar, ler e responder/excluir convites
    match /game_invites/{inviteId} {
      allow create, read, update, delete: if request.auth != null;
    }

    // 6. Mensagens Diretas / Sussurros Privados (Direct Messages)
    // Permite envio, leitura e atualização de status (lido) para usuários autenticados
    match /direct_messages/{messageId} {
      allow create, read, update, delete: if request.auth != null;
    }

    // 7. Bloquear qualquer outra coleção não autorizada expressamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
