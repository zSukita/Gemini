rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Modelo de Dados Assumido (Assumed Data Model)
    // ===============================================================
    //
    // Coleção: /users/{userId}
    //   - Ficha pessoal e preferências do usuário
    //   - Acesso: Apenas o próprio usuário autenticado (request.auth.uid == userId)
    //
    // Coleção: /campaigns/{campaignId}
    //   - id: string (imutável, igual a campaignId)
    //   - code: string (imutável, ex: ARC-XXXXXX)
    //   - name: string (tamanho 1-100)
    //   - description: string (tamanho 0-1000)
    //   - dmId: string (imutável, UID do Mestre criador)
    //   - dmName: string (tamanho 1-50)
    //   - members: map (Record<userId, CampaignPartyMember>)
    //   - createdAt: number (imutável)
    //   - activeHandout: map ou null (pista ativa)
    //   - Acesso Leitura: Apenas Mestre (dmId) ou membros participantes
    //   - Acesso Escrita: Mestre tem controle geral; Jogadores só podem ingressar, sair ou sincronizar seus próprios dados em 'members'
    //
    // Subcoleção: /campaigns/{campaignId}/handouts/{handoutId}
    //   - Acesso Leitura: Apenas Mestre e membros da campanha
    //   - Acesso Escrita: Apenas o Mestre da campanha
    //
    // Coleção: /campaign_codes/{code}
    //   - Índice público seguro para busca e validação de códigos sem expor dados internos das campanhas
    //   - Campos: code, campaignId, dmId, name, dmName, createdAt
    //   - Acesso Leitura: Qualquer usuário autenticado (busca por código)
    //   - Acesso Criação/Exclusão: Apenas o Mestre da campanha
    //
    // Coleção: /online_users/{userId}
    //   - Presença em tempo real no site
    //   - Acesso Leitura: Usuários autenticados
    //   - Acesso Escrita: Apenas o próprio usuário (request.auth.uid == userId)
    //
    // Coleção: /user_friends/{userId}
    //   - Lista de amigos do usuário
    //   - Acesso Leitura/Escrita: Apenas o próprio usuário (request.auth.uid == userId)
    //
    // Coleção: /game_invites/{inviteId}
    //   - Convites para jogar
    //   - Campos: id, fromUserId, fromUserName, toUserId, toUserName, roomCode, timestamp, status
    //   - Acesso Leitura/Exclusão: Apenas remetente (fromUserId) ou destinatário (toUserId)
    //   - Acesso Criação: Remetente autenticado, status 'pending', toUserId diferente de fromUserId
    //   - Acesso Atualização: Apenas destinatário autenticado, alterando EXCLUSIVAMENTE 'status' para 'accepted' ou 'declined'
    //
    // Coleção: /direct_messages/{messageId}
    //   - Mensagens diretas e sussurros
    //   - Campos: id, fromUserId, fromUserName, fromAvatarUrl, toUserId, toUserName, content, timestamp, read
    //   - Acesso Leitura/Exclusão: Apenas remetente (fromUserId) ou destinatário (toUserId)
    //   - Acesso Criação: Remetente autenticado, read == false, toUserId diferente de fromUserId
    //   - Acesso Atualização: Apenas destinatário autenticado, alterando EXCLUSIVAMENTE 'read' para true
    // ===============================================================

    // Funções Auxiliares Globais
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCampaignDM(campaignData) {
      return isAuthenticated() && campaignData.dmId == request.auth.uid;
    }

    function isCampaignParticipant(campaignData) {
      return isAuthenticated() && (
        campaignData.dmId == request.auth.uid ||
        (campaignData.members != null && request.auth.uid in campaignData.members)
      );
    }

    function isValidMemberJoin() {
      let memberDiff = request.resource.data.members.diff(resource.data.members);
      return memberDiff.addedKeys().hasOnly([request.auth.uid]) &&
             memberDiff.addedKeys().size() == 1 &&
             memberDiff.modifiedKeys().size() == 0 &&
             memberDiff.removedKeys().size() == 0 &&
             request.resource.data.members[request.auth.uid].userId == request.auth.uid;
    }

    function isValidMemberUpdate() {
      let memberDiff = request.resource.data.members.diff(resource.data.members);
      return memberDiff.addedKeys().size() == 0 &&
             memberDiff.modifiedKeys().hasOnly([request.auth.uid]) &&
             memberDiff.modifiedKeys().size() == 1 &&
             memberDiff.removedKeys().size() == 0 &&
             request.resource.data.members[request.auth.uid].userId == request.auth.uid;
    }

    function isValidMemberLeave() {
      let memberDiff = request.resource.data.members.diff(resource.data.members);
      return memberDiff.addedKeys().size() == 0 &&
             memberDiff.modifiedKeys().size() == 0 &&
             memberDiff.removedKeys().hasOnly([request.auth.uid]) &&
             memberDiff.removedKeys().size() == 1;
    }

    // 1. Dados Pessoais do Usuário (Fichas salvas, preferências)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Índice Público de Códigos de Campanhas
    match /campaign_codes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.dmId == request.auth.uid &&
        request.resource.data.code == code &&
        request.resource.data.campaignId is string;
      allow delete: if isAuthenticated() && resource.data.dmId == request.auth.uid;
    }

    // 3. Campanhas na Nuvem
    match /campaigns/{campaignId} {
      // Leitura: Permitida apenas para participantes (Mestre ou Jogadores da campanha)
      allow read: if isCampaignParticipant(resource.data);

      // Criação: Apenas o Mestre criador
      allow create: if isAuthenticated() &&
        request.resource.data.dmId == request.auth.uid &&
        request.resource.data.id == campaignId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.code is string;

      // Edição: Separada estritamente por operação
      // - Mestre: Controle geral, sem poder alterar campos imutáveis (dmId, id, code)
      // - Jogador: Apenas entrar (join), atualizar sua própria ficha (sync) ou sair (leave)
      allow update: if isAuthenticated() && (
        (
          resource.data.dmId == request.auth.uid &&
          request.resource.data.dmId == resource.data.dmId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.code == resource.data.code
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']) &&
          request.resource.data.dmId == resource.data.dmId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.code == resource.data.code &&
          (isValidMemberJoin() || isValidMemberUpdate() || isValidMemberLeave())
        )
      );

      // Exclusão: Apenas o Mestre criador
      allow delete: if isAuthenticated() && resource.data.dmId == request.auth.uid;

      // Pistas e Handouts da Campanha (leitura para participantes, escrita para o mestre)
      match /handouts/{handoutId} {
        allow read: if isCampaignParticipant(get(/databases/$(database)/documents/campaigns/$(campaignId)).data);
        allow write: if isCampaignDM(get(/databases/$(database)/documents/campaigns/$(campaignId)).data);
      }
    }

    // 4. Usuários Online (Presença em Tempo Real)
    match /online_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.status in ['online', 'in_game'] &&
        request.resource.data.lastSeen is number;
    }

    // 5. Lista de Amigos
    match /user_friends/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 6. Convites para Jogar (Game Invites)
    match /game_invites/{inviteId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.roomCode is string &&
        request.resource.data.roomCode.size() > 0 &&
        request.resource.data.roomCode.size() <= 40 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.timestamp is number;
      // Atualização: apenas o destinatário pode responder mudando EXCLUSIVAMENTE 'status' de 'pending' para 'accepted' ou 'declined'
      allow update: if isAuthenticated() &&
        resource.data.toUserId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['accepted', 'declined'];
      allow delete: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // 7. Mensagens Diretas / Sussurros Privados (Direct Messages)
    match /direct_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000 &&
        request.resource.data.read == false &&
        request.resource.data.timestamp is number;
      // Atualização: apenas o destinatário pode marcar como lida mudando EXCLUSIVAMENTE 'read' para true
      allow update: if isAuthenticated() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read == true;
      allow delete: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // 8. Bloquear qualquer outra coleção não autorizada expressamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
